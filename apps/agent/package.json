{
	"name": "@shrim/agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"scripts": {
		"dev": "vite dev --port 5174 --strictPort",
		"build": "vite build",
		"start": "node ../../scripts/serve.mjs build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@shrim/protocol": "workspace:*",
		"@shrim/ui": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.17.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
