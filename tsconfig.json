{
	"compilerOptions": {
		"target": "es2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2023", "dom"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	},
	"include": ["e2e", "scripts", "dev/*.mjs", "*.ts", "*.js"]
}
