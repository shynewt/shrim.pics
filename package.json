{
	"name": "shrim",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "pnpm --parallel --filter './apps/*' dev",
		"build": "pnpm --filter './apps/*' build",
		"check": "tsc -p . && pnpm --recursive check",
		"lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
		"format": "prettier --write apps packages e2e scripts .github 'dev/*.mjs' 'dev/immich/*.yml' '*.{js,ts,json,md}'",
		"format:check": "prettier --check apps packages e2e scripts .github 'dev/*.mjs' 'dev/immich/*.yml' '*.{js,ts,json,md}'",
		"test": "pnpm --filter @shrim/protocol --filter @shrim/relay test",
		"e2e": "playwright test",
		"verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test"
	},
	"packageManager": "pnpm@10.33.0",
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.64.1",
		"@types/node": "^22.20.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0"
	}
}
